\define img(src, caption)
<figure >
  <div style="display: flex; justify-content: center;">
  <img style="margin-left: auto; margin-right: auto;" src="$src$" alt="$caption$">
  </div>
  <figcaption style="text-align: center; font-style: italic; opacity: 0.8;">$caption$</figcaption>
</figure>
\end